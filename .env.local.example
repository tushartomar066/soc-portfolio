# ──────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in your real values.
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser.
# ──────────────────────────────────────────────────────────────

# EmailJS (https://www.emailjs.com/) — Contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# GitHub username whose public repos will be displayed
NEXT_PUBLIC_GITHUB_USERNAME=your_github_username

# (Optional) GitHub personal access token to raise the REST API rate limit.
# Used only server-side. Leave blank to use the unauthenticated limit.
GITHUB_TOKEN=
